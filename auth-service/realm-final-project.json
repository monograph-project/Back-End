{
  "id": "final-project",
  "realm": "final-project",
  "displayName": "Final Project",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Platform administrator"
      },
      {
        "name": "operator",
        "description": "Platform operator"
      },
      {
        "name": "teacher-user",
        "description": "Teacher user"
      },
      {
        "name": "student-user",
        "description": "Student user"
      },
      {
        "name": "faculty-user",
        "description": "Faculty staff user"
      },
      {
        "name": "auditor",
        "description": "Auditor user"
      }
    ],
    "client": {
      "control-version-service": [
        {
          "name": "version.read",
          "description": "Read version history"
        },
        {
          "name": "version.write",
          "description": "Create and update versions"
        },
        {
          "name": "version.audit",
          "description": "Audit version changes"
        }
      ],
      "weblog-service": [
        {
          "name": "weblog.read",
          "description": "Read weblog data"
        },
        {
          "name": "weblog.export",
          "description": "Export weblog data"
        }
      ],
      "faculty-service": [
        {
          "name": "faculty.read",
          "description": "Read faculty data"
        },
        {
          "name": "faculty.write",
          "description": "Write faculty data"
        },
        {
          "name": "faculty.admin",
          "description": "Administer faculty data"
        }
      ],
      "file-service": [
        {
          "name": "file.read",
          "description": "Read files"
        },
        {
          "name": "file.upload",
          "description": "Upload files"
        },
        {
          "name": "file.delete",
          "description": "Delete files"
        }
      ],
      "config-service": [
        {
          "name": "config.read",
          "description": "Read config"
        },
        {
          "name": "config.write",
          "description": "Write config"
        }
      ],
      "notification-service": [
        {
          "name": "notification.read",
          "description": "Read notifications"
        },
        {
          "name": "notification.send",
          "description": "Send notifications"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "admins",
      "realmRoles": [
        "admin"
      ],
      "clientRoles": {
        "faculty-service": [
          "faculty.admin",
          "faculty.read",
          "faculty.write"
        ],
        "config-service": [
          "config.read",
          "config.write"
        ],
        "file-service": [
          "file.read",
          "file.upload",
          "file.delete"
        ],
        "control-version-service": [
          "version.read",
          "version.write",
          "version.audit"
        ],
        "weblog-service": [
          "weblog.read",
          "weblog.export"
        ],
        "notification-service": [
          "notification.read",
          "notification.send"
        ]
      }
    },
    {
      "name": "operators",
      "realmRoles": [
        "operator"
      ],
      "clientRoles": {
        "weblog-service": [
          "weblog.read"
        ],
        "notification-service": [
          "notification.read",
          "notification.send"
        ],
        "config-service": [
          "config.read"
        ],
        "control-version-service": [
          "version.read"
        ]
      }
    },
    {
      "name": "teachers",
      "realmRoles": [
        "teacher-user"
      ],
      "clientRoles": {
        "faculty-service": [
          "faculty.read"
        ],
        "file-service": [
          "file.read",
          "file.upload"
        ],
        "control-version-service": [
          "version.read"
        ]
      }
    },
    {
      "name": "students",
      "realmRoles": [
        "student-user"
      ],
      "clientRoles": {
        "file-service": [
          "file.read"
        ]
      }
    },
    {
      "name": "faculty-staff",
      "realmRoles": [
        "faculty-user"
      ],
      "clientRoles": {
        "faculty-service": [
          "faculty.read",
          "faculty.write"
        ],
        "file-service": [
          "file.read",
          "file.upload"
        ]
      }
    },
    {
      "name": "auditors",
      "realmRoles": [
        "auditor"
      ],
      "clientRoles": {
        "control-version-service": [
          "version.audit"
        ],
        "weblog-service": [
          "weblog.read"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "auth-service-admin",
      "name": "Auth Service Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${AUTH_SERVICE_ADMIN_CLIENT_SECRET}",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "control-version-service",
      "name": "Control Version Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${CONTROL_VERSION_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "weblog-service",
      "name": "Weblog Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${WEBLOG_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "faculty-service",
      "name": "Faculty Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${FACULTY_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "file-service",
      "name": "File Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${FILE_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "config-service",
      "name": "Config Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${CONFIG_SERVICE_CLIENT_SECRET}"
    },
    {
      "clientId": "notification-service",
      "name": "Notification Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${NOTIFICATION_SERVICE_CLIENT_SECRET}"
    }
  ],
  "users": []
}